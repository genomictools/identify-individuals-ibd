singularity {
  enabled = true
  autoMounts = true
}

process {
  withLabel: 'plink'    { container = 'plink.1.9' }
  withLabel: 'bcftools' { container = 'bcftools.1.20' }
}

params {
  cohorts     = null
  output_dir  = './results'
  maf         = 0.05
  geno        = 0.5
  n_snps      = 10000
  snp_name    = 'SNP Name,Name'
  chr         = 'Chr'
  position    = 'Position'
  allele_ab_a = 'Allele1 - AB'
  allele_ab_b = 'Allele2 - AB'
  allele_a    = 'Allele1 - Top'
  allele_b    = 'Allele2 - Top'
}

profiles {
  local   { includeConfig 'conf/local.config' }
  cluster { includeConfig 'conf/cluster.config' }

  test {
    params {
      cohorts  = "test-datasets/cohorts_info.csv"
      manifest = 'test-datasets/manifest.csv'
      fasta    = 'test-datasets/homo_sapiens.fasta'
      pfb      = "test-datasets/dbsnp.pfb"
    }
  }
}
